PORT=5000
MONGODB_URI=mongodb://mongo:27017/chatcta
JWT_SECRET=chatcta_super_secret_key_change_this

# Admin
ADMIN_EMAIL=admin@chatcta.com
ADMIN_PASSWORD=Admin@12345

# Frontend
FRONTEND_URL=http://localhost:3000

# Facebook / Instagram
FB_APP_ID=your_fb_app_id
FB_APP_SECRET=your_fb_app_secret
FB_VERIFY_TOKEN=chatcta_verify_2024

# WhatsApp Business API
WA_VERIFY_TOKEN=chatcta_verify_2024
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_BUSINESS_ACCOUNT_ID=your_business_account_id
WA_ACCESS_TOKEN=your_wa_access_token

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# OpenAI (for AI responses & auto-translation)
OPENAI_API_KEY=your_openai_api_key

# Web Push Notifications
# Generate keys: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# LibreTranslate (free self-hosted translation alternative)
# LIBRE_TRANSLATE_URL=http://localhost:5001

# SMTP (configure via admin panel too)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_password
