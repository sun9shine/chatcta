# ===========================
# ChatCTA - Environment Config
# Copy this file to .env and fill in your values
# ===========================

# Server Ports
HTTP_PORT=80
HTTPS_PORT=443

# Admin Account
ADMIN_EMAIL=admin@chatcta.com
ADMIN_PASSWORD=Admin@12345

# Security
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Frontend URL (for password reset emails)
FRONTEND_URL=http://your-domain.com
REACT_APP_API_URL=/api

# Facebook / Instagram
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=chatcta_verify_2024

# WhatsApp Business
WA_VERIFY_TOKEN=chatcta_verify_2024

# OpenAI (for AI responses)
OPENAI_API_KEY=

# For local development, run:
# docker-compose up -d
#
# For VPS, edit this file then run:
# docker-compose up -d --build
